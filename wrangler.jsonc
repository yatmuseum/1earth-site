{
  // How Cloudflare runs 1-Earth: the website files in ./dist, plus the server
  // code in worker/ for anything under /api/.
  "name": "1earth-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Keep request logs on, so errors can be looked up in the Cloudflare dashboard.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "MINT_GATE", "class_name": "MintGate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MintGate"] }],

  // Public mint settings. Currently: PRE-LAUNCH display (devnet, not live).
  // Secrets (HELIUS_API_KEY, MINTER_SECRET_KEY) are set in the Cloudflare dashboard, never here.
  "vars": {
    "NETWORK": "mainnet-beta",
    "MINT_LIVE": "true",
    "OPENS_AT": "2026-11-06T23:57:00Z",
    "PRICE_USDC": "0.01",
    "SUPPLY": "32",
    "COLLECTION": "AUqmMQYa2bQRX6GYeYLhW7VqzMp4LjCojeKS7ZRx41Cp",
    "MERKLE_TREE": "6bJ9uAHsUoThhbAowLtZzxgkTCMmUUMs4Gf26GAq8H6N",
    "TREASURY": "HvPMmCHju5niMUKkGhJNruY8fGbzHT1caELqSjefSBeM",
    "USDC_MINT": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
    "METADATA_URI": "https://1-earth.io/f.json",
    "BLOCKED_COUNTRIES": "CR,IR,KP,CU,SY",
    "ALLOWLIST": "5aiehK38cf8xtXapGv2XtBWBcCC4xqwyMZV4vu9WKTDX,BnE8WFXzFAgJ4XGNhmb14y4svNGHy5UCXkkmZbvWw5Ee,Hcam3n4fm27Rh4BFZBngym7oxGGdP99jzE3WbaesRyfh",
    "LOOKUP_TABLE": "3qn2TVMbRWpsujSgiayKN8gDsVQQJLZ9dStoyDaTzCwK"
  }
}
