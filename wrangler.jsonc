{
  // Tells Cloudflare how to deploy 1-Earth: the website files in ./dist,
  // plus the server code in worker/index.js for anything under /api/.
  "name": "1earth-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
