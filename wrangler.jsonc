{
  // How Cloudflare runs 1-Earth: the website files in ./dist, plus the server
  // code in worker/ for anything under /api/.
  "name": "1earth-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "MINT_GATE", "class_name": "MintGate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MintGate"] }],

  // Public mint settings. Currently: PRE-LAUNCH display (devnet, not live).
  // Secrets (HELIUS_API_KEY, MINTER_SECRET_KEY) are set in the Cloudflare dashboard, never here.
  "vars": {
    "NETWORK": "devnet",
    "MINT_LIVE": "false",
    "OPENS_AT": "2026-11-11T16:11:00Z",
    "PRICE_USDC": "20",
    "SUPPLY": "10000",
    "COLLECTION": "4NpwwABJmuenjBpa9WK4zg67rqvPKNfQ9JdsNDj11wvu",
    "MERKLE_TREE": "Ba2D6NAGfyk42wPiqUKAcQpKe5zYg2aBNLfZfqhqVCKG",
    "TREASURY": "43vjVKMpnTr7hj2L84rZ9pHtX2Nn2MeKG5KBWWjPHDNQ",
    "USDC_MINT": "4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU",
    "METADATA_URI": "https://1-earth.io/metadata/entry.json",
    "BLOCKED_COUNTRIES": "CR,IR,KP,CU,SY"
  }
}
